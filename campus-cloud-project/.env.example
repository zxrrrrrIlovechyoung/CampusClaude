# Copia este archivo como .env y reemplaza los valores locales.
# No uses estas credenciales en producción ni las publiques en GitHub.

POSTGRES_USER=campuscloud_user
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=campuscloud
POSTGRES_PORT=5432
POSTGRES_VOLUME=campuscloud-postgres-data

PGADMIN_DEFAULT_EMAIL=admin@example.local
PGADMIN_PASSWORD=change_me_pgadmin
PGADMIN_PORT=5050
PGADMIN_VOLUME=campuscloud-pgadmin-data

MSSQL_SA_PASSWORD=Change_me_SQL_Server_123!
MSSQL_PORT=1433
SQLSERVER_VOLUME=campuscloud-sqlserver-data

NEO4J_PASSWORD=change_me_neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_VOLUME=campuscloud-neo4j-data

MONGO_INITDB_ROOT_USERNAME=campuscloud_root
MONGO_INITDB_ROOT_PASSWORD=change_me_mongo_root
MONGO_DATABASE=campuscloud
MONGO_APP_USER=campuscloud_app
MONGO_APP_PASSWORD=change_me_mongo_app
MONGO_PORT=27017
MONGO_VOLUME=campuscloud-mongo-data

CASSANDRA_PORT=9042
CASSANDRA_VOLUME=campuscloud-cassandra-data

DOCKER_NETWORK=campuscloud_net
